{
  "name": "deskfence",
  "version": "1.0.0",
  "description": "Desktop organization app with fences, peek mode, and automation",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "start": "vite build && electron . --dist",
    "build": "vite build",
    "build:renderer": "vite build",
    "package": "vite build && electron-builder",
    "package:win": "vite build && electron-builder --win"
  },
  "keywords": [
    "desktop",
    "organization",
    "fences",
    "productivity"
  ],
  "author": "AYPEE Industries",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.15.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "electron-localshortcut": "^3.2.1",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.aypee.deskfence",
    "productName": "DeskFence",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "main.js",
      "desktop-icons.js",
      "drag-watch.js",
      "shortcut-finder.js",
      "fence-merge.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
